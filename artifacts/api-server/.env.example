# Backend Environment Variables
# Copy this to .env and fill in values

# Required: JWT secrets (generate random strings)
JWT_SECRET=your-random-jwt-secret-here
JWT_REFRESH_SECRET=your-random-refresh-secret-here

# Server
NODE_ENV=development
PORT=8080

# CORS (comma-separated origins, or leave empty for defaults)
CORS_ORIGINS=

# WhatsApp OTP (optional - without this, OTP is printed to console only)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
